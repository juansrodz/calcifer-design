{
  "name": "@calcifer-design/tokens",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juansrodz/calcifer-design.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://juansrodz.github.io/calcifer-design/",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "rslib build && bun scripts/write-css.ts",
    "dev": "bun scripts/dev.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts"
  },
  "devDependencies": {
    "@calcifer-design/tsconfig": "workspace:*",
    "@rslib/core": "1.0.0",
    "fast-glob": "^3.3.3"
  }
}
