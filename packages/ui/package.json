{
  "name": "@calcifer-design/ui",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juansrodz/calcifer-design.git",
    "directory": "packages/ui"
  },
  "homepage": "https://juansrodz.github.io/calcifer-design/",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/**/*.module.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base.css": "./dist/styles/base.css"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "typecheck": "bun run build && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@calcifer-design/tokens": "workspace:*",
    "@tanstack/react-table": "^9.2.4"
  },
  "devDependencies": {
    "@calcifer-design/tsconfig": "workspace:*",
    "@rsbuild/core": "^2.2.3",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-typed-css-modules": "^1.2.4",
    "@rslib/core": "1.0.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "^30.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "^10.6.0",
    "storybook-react-rsbuild": "^3.4.2",
    "vitest": "^5.0.0",
    "vitest-axe": "1.0.0-pre.5"
  }
}
